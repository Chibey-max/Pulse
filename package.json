{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:contracts && pnpm run test:client",
    "test:client": "vitest run",
    "test:contracts": "forge test",
    "deploy:test": "forge script scripts/DeployPulseSessionFactory.s.sol --rpc-url \"$NEXT_PUBLIC_RPC_URL\" --broadcast --verify",
    "lint-staged": "lint-staged",
    "validate-branch-name": "validate-branch-name",
    "prepare": "husky"
  },
  "validate-branch-name": {
    "pattern": "^(main|develop)$|^(feat|feature|fix|chore|docs|refactor|perf|style|test|hotfix)/.+$",
    "errorMsg": "Branch name must be main, develop, or <type>/<topic> where type is one of: feat, feature, fix, chore, docs, refactor, perf, style, test, hotfix."
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "^0.29.0",
    "@somnia-chain/reactivity": "^0.2.1",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.56.3",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "validate-branch-name": "^1.3.2",
    "vitest": "^4.1.11"
  }
}
