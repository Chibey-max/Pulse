# App data source. Unset or "1" = sample data (default). "0" = live SDK, which also
# requires NEXT_PUBLIC_INDEXER_URL and NEXT_PUBLIC_WS_RPC_URL to be set. Never ship "0"
# without the live wiring in src/lib/app-data/source.ts.
NEXT_PUBLIC_MOCK=1

# Server-only deployment key. Never expose this as NEXT_PUBLIC_*.
