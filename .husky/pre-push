#!/usr/bin/env bash

set -e

# 1 Validate branch name
echo "🔖 Validating branch name..."
pnpm run validate-branch-name || {
  echo "❌ Invalid branch name. Push aborted."
  exit 1
}

# 2 Type-check and lint before every push
echo "🔎 Type-checking..."
pnpm run typecheck || {
  echo "❌ Type-check failed. Push aborted."
  exit 1
}

echo "🧹 Linting..."
pnpm run lint || {
  echo "❌ Lint failed. Push aborted."
  exit 1
}
echo "✅ Type-check and lint passed."

# 3 Solidity checks, only when Foundry is installed
if command -v forge >/dev/null 2>&1; then
  echo "🎨 Checking Solidity formatting..."
  forge fmt --check || {
    echo "❌ forge fmt --check failed. Run 'forge fmt'. Push aborted."
    exit 1
  }
  echo "🧪 Running contract tests..."
  forge test || {
    echo "❌ Contract tests failed. Push aborted."
    exit 1
  }
else
  echo "⏭  Skipping Solidity checks (forge not installed)."
fi

# 4 Protected branch checks, run when pushing to develop or main
current_user=$(git config user.email)
allowed_users="davidilorah@gmail.com musamarch022005@gmail.com ilorahdavid126@gmail.com"
z40=0000000000000000000000000000000000000000

# Vendored trees. These ship with large files we do not control, so the size
# checks below would fail forever if they were scanned.
vendored='^(lib/forge-std/)'

is_allowed_user() {
  for _u in $allowed_users; do
    if [ "$current_user" = "$_u" ]; then
      return 0
    fi
  done
  return 1
}

