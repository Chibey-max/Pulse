while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/develop)
      # No deleting or force-pushing develop
      if [ "$local_sha" = "$z40" ]; then
        echo "❌ Deleting develop is restricted."
        exit 1
      fi
      if [ "$remote_sha" != "$z40" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        echo "❌ Force push to develop is restricted."
        exit 1
      fi
      # check_heavy_files
      ;;

    refs/heads/main)
      # Only allowlisted users can push to main
      if ! is_allowed_user; then
        echo "❌ Only these users can push to main: $allowed_users"
        echo "   Your git config user.email is: $current_user"
        exit 1
      fi
      if [ "$local_sha" = "$z40" ]; then
        echo "❌ Deleting main is restricted."
        exit 1
      fi
      if [ "$remote_sha" != "$z40" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        echo "❌ Force push to main is restricted."
        exit 1
      fi
      # check_heavy_files
      ;;
  esac
done

echo "✅ Pre-push checks passed."

exit 0
